generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique
  /// scrypt hash, see `src/auth/passwords.ts`.
  passwordHash   String
  /// Unique public handle, lowercase; see `username` in `src/realtime/protocol.ts`.
  username       String           @unique @db.VarChar(20)
  displayName    String           @db.VarChar(24)
  avatarSpriteId String           @default("scholar_01") @db.VarChar(32)
  bio            String?          @db.VarChar(80)
  /// Whether other readers may see this reader's focus time.
  statsVisible   Boolean          @default(true)
  /// Daily and weekly focus goals in minutes; null means no goal.
  dailyGoalMinutes  Int?
  weeklyGoalMinutes Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  focusSessions  FocusSession[]
  ownedRooms     Room[]
  memberships    RoomMembership[]
  roomBans       RoomBan[]
  categories     Category[]
  chatMessages   ChatMessage[]
  tasks          FocusTask[]
  following      Follow[]         @relation("follower")
  followers      Follow[]         @relation("followee")
  eventRsvps     RoomEventRsvp[]
  blocking       UserBlock[]      @relation("blocker")
  blockedBy      UserBlock[]      @relation("blocked")
  reportsFiled   Report[]         @relation("reporter")
  reportsAgainst Report[]         @relation("reported")
  pushDevices    PushDevice[]
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

/// A user-created room. System halls ("Piksel Salon N") live only in Redis.
model Room {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(6)
  name        String           @db.VarChar(32)
  symbol      String           @db.VarChar(48)
  color       String           @db.VarChar(16)
  visibility  RoomVisibility
  theme       String           @default("classic") @db.VarChar(24)
  /// What the room is for, shown before joining.
  description String?          @db.VarChar(200)
  ownerId     String           @db.Uuid
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  memberships RoomMembership[]
  bans        RoomBan[]
  events      RoomEvent[]

  @@index([visibility, createdAt])
}

/// Readers the owner removed from a room; they cannot enter it again until unbanned.
model RoomBan {
  roomId    String   @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([roomId, userId])
}

/// Rooms a reader created or entered, for the "Odalarım" list.
model RoomMembership {
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId        String   @db.Uuid
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime @default(now())

  @@id([userId, roomId])
  @@index([userId, lastVisitedAt])
}

/// A reader's own focus category, next to the built-in ones in `src/categories/built-in-categories.ts`.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(24)
  symbol    String   @db.VarChar(48)
  color     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

enum SessionEndReason {
  STOOD_UP
  LEASE_EXPIRED
}

enum TimerMode {
  POMODORO
  STOPWATCH
}

/// Category and room are copied in, so history survives renamed or deleted categories and rooms.
model FocusSession {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId         String           @db.VarChar(64)
  roomName       String           @db.VarChar(32)
  deskId         String           @db.VarChar(16)
  mode           TimerMode
  categoryKey    String           @db.VarChar(64)
  categoryName   String           @db.VarChar(24)
  categorySymbol String           @db.VarChar(48)
  categoryColor  String           @db.VarChar(16)
  note           String?          @db.VarChar(48)
  startedAt      DateTime
  endedAt        DateTime
  focusedMs      Int
  endReason      SessionEndReason

  @@index([userId, startedAt])
}

/// A chat line in a room (user room or system hall). Kept until the room or the author is deleted.
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.VarChar(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.VarChar(500)
  /// Chosen by the sending device, so a retried send cannot post twice.
  clientId  String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([roomId, createdAt])
}

/// A to-do the reader plans to get through in their sessions.
model FocusTask {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(120)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

/// One reader following another, to see when they focus and to compare weeks.
model Follow {
  followerId String   @db.Uuid
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String   @db.Uuid
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

/// A focus session the owner schedules in their room, e.g. "Tomorrow 09:00, 3 pomodoros".
model RoomEvent {
  id              String          @id @default(uuid()) @db.Uuid
  roomId          String          @db.Uuid
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title           String          @db.VarChar(60)
  startsAt        DateTime
  durationMinutes Int
  createdAt       DateTime        @default(now())
  rsvps           RoomEventRsvp[]

  @@index([roomId, startsAt])
}

/// A reader who said they will come; their device schedules the reminder.
model RoomEventRsvp {
  eventId   String    @db.Uuid
  event     RoomEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([eventId, userId])
  @@index([userId])
}

/// A reader who never wants to see or hear from another: no chat, follows, search or profile.
model UserBlock {
  blockerId String   @db.Uuid
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
}

/// A complaint about a reader or one of their chat messages, kept for review.
/// The message text is copied in, so evidence survives the message being deleted.
model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  reporter     User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId   String       @db.Uuid
  reported     User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason       ReportReason
  note         String?      @db.VarChar(300)
  messageId    String?      @db.Uuid
  messageBody  String?      @db.VarChar(500)
  roomId       String?      @db.VarChar(64)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([messageId])
}

enum PushEnvironment {
  SANDBOX
  PRODUCTION
}

/// An APNs device token, for reaching a reader while the app is closed.
model PushDevice {
  token       String          @id @db.VarChar(200)
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment PushEnvironment
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}
