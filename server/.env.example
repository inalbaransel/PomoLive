NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pomolive:pomolive@localhost:5432/pomolive?schema=public
REDIS_URL=redis://localhost:6379
# 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=change-me-change-me-change-me-change-me
# The iOS app's bundle identifier, used as the audience of Apple identity tokens.
APPLE_BUNDLE_ID=com.baransel.pomolive
# iOS OAuth client ID(s) from Google Cloud Console, comma separated. Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=
# SMTP for e-mail sign-in codes, e.g. smtps://resend:API_KEY@smtp.resend.com:465
# Leave empty in development: codes are printed to the server log instead.
SMTP_URL=
MAIL_FROM=PomoLive <giris@harbidigital.com>
