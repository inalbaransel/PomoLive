      }
    },
    "Bir masaya otur, lamban yansın. Salondaki herkes kendi işine odaklanırken sen de yalnız değilsin. Konuşmak zorunda değilsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a desk and your lamp lights up. Everyone in the hall focuses on their own work, so you're never alone. No need to talk."
          }
        }
      }
    },
    "Bir odada masaya oturup en az bir dakika odaklandığında burada görünür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit at a desk in any room and focus for at least a minute to see it here."
          }
